{
  "name": "vanhanh-desktop",
  "version": "1.3.5",
  "private": true,
  "type": "module",
  "description": "Vận Hành – ứng dụng desktop quản lý vận tải hành khách",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "npm run build && electron .",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "pack": "npm run build && electron-builder --dir",
    "db:init": "node scripts/init-database.js",
    "test": "node --test server/tests/*.test.js desktop/tests/*.test.cjs",
    "test:integration": "node --test --test-concurrency=1 server/tests/integration.js server/tests/registration.integration.js server/tests/passenger.integration.js",
    "postinstall": "node node_modules/electron/install.js",
    "test:registration": "node --test server/tests/registration.integration.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "lucide-react": "^0.468.0",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "productName": "VanHanh",
  "main": "desktop/main.mjs",
  "author": "Project 5"
}
